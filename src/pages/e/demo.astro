---
import Base from "../../layouts/Base.astro";
import ScaleBox from "../../components/ScaleBox.astro";
import GuestPhone from "../../components/GuestPhone.astro";
import Decision from "../../components/Decision.astro";
import { domainDecision, eventLink } from "../../content/provisional";
import "../../styles/global.css";

const phones = [
  { label: "RSVP · Open", variant: "open" as const },
  { label: "RSVP · Success", variant: "success" as const },
  { label: "Page top", variant: "top" as const },
];
---

<Base title="Spooky Soirée — RSVP" description="Guest view for the Halloween demo. RSVP stays in the browser." demo>
  <main id="main" class="guest-view">
    <header class="guest-intro">
      <p class="kicker">GUEST VIEW</p>
      <h1>What guests see at {eventLink("spooky-soiree")}</h1>
      <p>Real Halloween template modules · RSVP open and success states</p>
    </header>
    <div class="guest-phones">
      {
        phones.map((phone) => (
          <figure>
            <figcaption>{phone.label}</figcaption>
            <div class="phone-frame">
              <ScaleBox width={390} height={844} phone>
                <GuestPhone variant={phone.variant} />
              </ScaleBox>
            </div>
          </figure>
        ))
      }
    </div>
    <Decision title="Domain name" body={domainDecision()} />
  </main>
</Base>
<script>
  import { applyDraft } from "../../scripts/draft";
  applyDraft();
  document.querySelectorAll<HTMLButtonElement>("[data-count]").forEach((button) => {
    button.addEventListener("click", () => {
      const output = button.parentElement?.querySelector<HTMLOutputElement>("[data-count-value]");
      if (!output) return;
      const next = Math.min(12, Math.max(1, Number(output.value) + Number(button.dataset.count)));
      output.value = String(next);
    });
  });
  document.querySelector("[data-rsvp]")?.addEventListener("submit", (event) => {
    event.preventDefault();
    document.getElementById("rsvp-success")?.focus();
  });
</script>
