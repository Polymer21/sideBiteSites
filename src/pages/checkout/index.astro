---
import Base from "../../layouts/Base.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import CardMarks from "../../components/CardMarks.astro";
import { monthlyPrice, plans, plansCatalog } from "../../content/plans";
import "../../styles/global.css";
---

<Base
  title="Checkout — Sidebite"
  description="Choose a monthly plan. Every plan starts with a 7-day free trial and a card on file."
>
  <header class="flow-header">
    <a class="logo" href="/">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-word">Sidebite</span>
    </a>
    <span class="pill" style="margin-left:auto">Secure checkout</span>
  </header>
  <main id="main" class="flow">
    <header class="stack">
      <h1 class="h2">Choose a plan to start</h1>
      <p class="lead">
        {plansCatalog.trialDays}-day free trial. Card required. You won’t be charged today, and the page build starts after checkout.
      </p>
      <CardMarks />
    </header>
    <div class="tiers" aria-label="Plans">
      {
        plans.map((plan) => (
          <article class:list={["tier", plan.popular && "tier-pop"]}>
            <h2 class="facts-title">{plan.name}</h2>
            <p>
              <span class="price">{monthlyPrice(plan.price)}</span>
            </p>
            <a class="btn btn-primary btn-block" href={`/checkout/${plan.id}`}>
              {plan.cta}
            </a>
          </article>
        ))
      }
    </div>
  </main>
  <SiteFooter />
</Base>
