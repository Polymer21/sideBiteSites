---
import Base from "../../layouts/Base.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import CardMarks from "../../components/CardMarks.astro";
import { money, monthlyPrice, plans, plansCatalog } from "../../content/plans";
import "../../styles/global.css";
---

<Base
  title="Checkout — Sidebite"
  description="Start free for a week, or choose a monthly plan. A card is required. Free renews automatically as Gather."
>
  <header class="flow-header">
    <a class="logo" href="/">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-word">Sidebite</span>
    </a>
    <span class="pill" style="margin-left:auto">Secure checkout</span>
  </header>
  <main id="main" class="flow">
    <header class="stack">
      <h1 class="h2">Choose a plan to start</h1>
      <p class="lead">
        {plansCatalog.trialDays}-day trial. Card required. Free renews automatically as Gather at {money(plansCatalog.prices.gather)}/month unless you cancel. The page build starts after checkout.
      </p>
      <CardMarks />
    </header>
    <div class="tiers" aria-label="Plans">
      {
        plans.map((plan) => (
          <article class:list={["tier", plan.popular && "tier-pop"]}>
            <h2 class="facts-title">{plan.name}</h2>
            <p>
              <span class="price">{plan.id === "free" ? money(plan.price) : monthlyPrice(plan.price)}</span>
              {plan.id === "free" && <span class="muted">{plan.blurb} Renews automatically as Gather.</span>}
            </p>
            <a class="btn btn-primary btn-block" href={`/checkout/${plan.id}`}>
              {plan.cta}
            </a>
          </article>
        ))
      }
    </div>
  </main>
  <SiteFooter />
</Base>
