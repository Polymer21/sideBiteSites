---
import Base from "../../layouts/Base.astro";
import FlowHeader from "../../components/FlowHeader.astro";
import EventPage from "../../components/EventPage.astro";
import ScaleBox from "../../components/ScaleBox.astro";
import { sections, defaultDraft } from "../../content/copy";
import "../../styles/global.css";
---

<Base title="Editor — Sidebite" description="Customize your event page. Nothing is saved." demo>
  <FlowHeader step={4} save editor />
  <main id="main" class="editor-page">
    <div class="tabs mob" role="tablist" aria-label="Editor">
      <button class="chip" type="button" role="tab" aria-selected="true" data-tab="sections">Sections</button>
      <button class="chip" type="button" role="tab" aria-selected="false" data-tab="content">Content</button>
      <button class="chip" type="button" role="tab" aria-selected="false" data-tab="look">Look</button>
    </div>
    <div class="editor">
      <section class="editor-col is-on" data-pane="sections" aria-labelledby="sections-label">
        <h1 id="sections-label" class="facts-title">Sections</h1>
        <p class="muted">Drag to reorder. Toggle to hide.</p>
        <ul id="section-list">
          {
            sections.map((section, index) => (
              <li class="section-row" data-id={section.id} draggable="true">
                <span class="fine" aria-hidden="true">⋮⋮</span>
                <span class="name">{section.label}</span>
                <button class="icon-btn" type="button" data-move="up" aria-label={`Move ${section.label} up`} disabled={index === 0}>↑</button>
                <button class="icon-btn" type="button" data-move="down" aria-label={`Move ${section.label} down`} disabled={index === sections.length - 1}>↓</button>
                <button class="switch" type="button" role="switch" aria-checked="true" aria-label={`Show ${section.label}`} data-toggle={section.id}>
                  <i></i>
                </button>
              </li>
            ))
          }
        </ul>
        <button class="btn btn-link" type="button" id="add-section">Add section</button>
      </section>
      <section class="editor-col" data-pane="content" aria-labelledby="content-label">
        <h2 id="content-label" class="facts-title">Hero</h2>
        <label class="field">Event name
          <input name="name" data-edit="name" value={defaultDraft.name} />
        </label>
        <label class="field">Tagline
          <input name="tagline" data-edit="tagline" value={defaultDraft.tagline} />
        </label>
        <div class="field-row">
          <label class="field">Date
            <input name="date" data-edit="date" value={defaultDraft.date} />
          </label>
          <label class="field">Time
            <input name="time" data-edit="time" value={defaultDraft.time} />
          </label>
        </div>
        <label class="field">Button label
          <input name="button" data-edit="button" value={defaultDraft.button} />
        </label>
        <label class="drop" for="hero-file">
          Hero image
          <span>Drop an image or browse</span>
          <input id="hero-file" type="file" accept="image/*" />
        </label>
      </section>
      <section class="editor-stage" data-pane="look">
        <div class="device-toggle" role="group" aria-label="Preview width">
          <button class="chip" type="button" data-device="desktop" aria-pressed="true">Desktop</button>
          <button class="chip" type="button" data-device="phone" aria-pressed="false">Mobile</button>
        </div>
        <div class="preview-frame" id="editor-preview">
          <ScaleBox width={1440} height={1860}>
            <EventPage idPrefix="editor" form="open" />
          </ScaleBox>
        </div>
      </section>
    </div>
  </main>
</Base>
<script>
  import { readDraft, writeDraft, applyDraft } from "../../scripts/draft";
  import type { SectionId } from "../../content/copy";

  const list = document.getElementById("section-list");
  const preview = document.getElementById("editor-preview");

  const syncOrder = () => {
    if (!list || !preview) return;
    const ids = [...list.querySelectorAll<HTMLElement>("[data-id]")].map((row) => row.dataset.id);
    ids.forEach((id) => {
      const section = preview.querySelector<HTMLElement>(`[data-section="${id}"]`);
      if (section) preview.querySelector("[data-event-root]")?.append(section.parentElement === preview.querySelector(".event-body") ? section : section);
    });
    const body = preview.querySelector(".event-body");
    ids.forEach((id) => {
      if (id === "hero") return;
      const section = preview.querySelector<HTMLElement>(`[data-section="${id}"]`);
      if (section && body) body.append(section);
    });
    const hero = preview.querySelector<HTMLElement>('[data-section="hero"]');
    const root = preview.querySelector("[data-event-root]");
    if (hero && root) root.prepend(hero);
  };

  const refreshButtons = () => {
    const rows = [...(list?.querySelectorAll<HTMLElement>("[data-id]") ?? [])];
    rows.forEach((row, index) => {
      const up = row.querySelector<HTMLButtonElement>('[data-move="up"]');
      const down = row.querySelector<HTMLButtonElement>('[data-move="down"]');
      if (up) up.disabled = index === 0;
      if (down) down.disabled = index === rows.length - 1;
    });
  };

  const move = (id: string, direction: -1 | 1) => {
    const row = list?.querySelector<HTMLElement>(`[data-id="${id}"]`);
    if (!row) return;
    const sibling = direction < 0 ? row.previousElementSibling : row.nextElementSibling;
    if (!sibling) return;
    if (direction < 0) row.parentElement?.insertBefore(row, sibling);
    else row.parentElement?.insertBefore(sibling, row);
    syncOrder();
    refreshButtons();
  };

  list?.addEventListener("click", (event) => {
    const target = (event.target as HTMLElement).closest("button");
    if (!target || !list.contains(target)) return;
    const row = target.closest<HTMLElement>("[data-id]");
    if (!row?.dataset.id) return;
    if (target.dataset.move === "up") move(row.dataset.id, -1);
    if (target.dataset.move === "down") move(row.dataset.id, 1);
    if (target.dataset.toggle) {
      const on = target.getAttribute("aria-checked") !== "true";
      target.setAttribute("aria-checked", String(on));
      const hidden = new Set(readDraft().hidden);
      const id = target.dataset.toggle as SectionId;
      if (on) hidden.delete(id);
      else hidden.add(id);
      writeDraft({ hidden: [...hidden] });
      applyDraft(preview ?? document);
    }
  });

  let dragId = "";
  list?.addEventListener("dragstart", (event) => {
    const row = (event.target as HTMLElement).closest<HTMLElement>("[data-id]");
    dragId = row?.dataset.id || "";
  });
  list?.addEventListener("dragover", (event) => {
    event.preventDefault();
    const row = (event.target as HTMLElement).closest<HTMLElement>("[data-id]");
    if (!row || row.dataset.id === dragId) return;
    const dragging = list.querySelector<HTMLElement>(`[data-id="${dragId}"]`);
    if (dragging) row.before(dragging);
  });
  list?.addEventListener("drop", () => {
    syncOrder();
    refreshButtons();
  });

  document.querySelectorAll<HTMLInputElement>("[data-edit]").forEach((input) => {
    const draft = readDraft();
    const key = input.dataset.edit as keyof typeof draft;
    if (typeof draft[key] === "string") input.value = draft[key] as string;
    input.addEventListener("input", () => {
      writeDraft({ [input.dataset.edit || "name"]: input.value });
      applyDraft(preview ?? document);
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-device]").forEach((button) => {
    button.addEventListener("click", () => {
      document.querySelectorAll<HTMLButtonElement>("[data-device]").forEach((other) => {
        other.setAttribute("aria-pressed", String(other === button));
      });
      preview?.classList.toggle("is-phone", button.dataset.device === "phone");
    });
  });

  document.getElementById("hero-file")?.addEventListener("change", (event) => {
    const file = (event.target as HTMLInputElement).files?.[0];
    const art = preview?.querySelector<HTMLElement>("[data-hero-art]");
    if (!file || !art) return;
    const url = URL.createObjectURL(file);
    art.style.background = `center / cover no-repeat url("${url}")`;
    art.querySelectorAll("span").forEach((span) => {
      if (!span.classList.contains("decor")) span.style.visibility = "hidden";
    });
  });

  document.getElementById("add-section")?.addEventListener("click", () => {
    const hidden = readDraft().hidden.filter((id) => id !== "gallery");
    writeDraft({ hidden });
    const toggle = list?.querySelector<HTMLButtonElement>('[data-toggle="gallery"]');
    toggle?.setAttribute("aria-checked", "true");
    applyDraft(preview ?? document);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((other) => {
        other.setAttribute("aria-selected", String(other === tab));
      });
      const name = tab.dataset.tab;
      document.querySelectorAll<HTMLElement>("[data-pane]").forEach((pane) => {
        pane.classList.toggle("is-on", pane.dataset.pane === name);
      });
    });
  });

  const draft = readDraft();
  draft.hidden.forEach((id) => {
    list?.querySelector(`[data-toggle="${id}"]`)?.setAttribute("aria-checked", "false");
  });
  applyDraft(preview ?? document);
</script>
