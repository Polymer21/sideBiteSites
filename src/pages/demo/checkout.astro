---
import Base from "../../layouts/Base.astro";
import CheckoutEntry from "../../components/CheckoutEntry.astro";
import "../../styles/global.css";
---

<Base title="Checkout — Sidebite" description="Start a monthly plan. A card is required for the 7-day trial." demo>
  <header class="flow-header">
    <a class="logo" href="/">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-word">Sidebite</span>
    </a>
    <span class="pill" style="margin-left:auto">Secure checkout</span>
  </header>
  <CheckoutEntry planId="celebrate" />
</Base>
