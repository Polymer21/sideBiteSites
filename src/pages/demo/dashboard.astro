---
import Base from "../../layouts/Base.astro";
import Provisional from "../../components/Provisional.astro";
import { eventLink, keepLivePrice, money, provisional } from "../../content/provisional";
import { defaultDraft, guests, upgradePrompts } from "../../content/copy";
import "../../styles/global.css";
---

<Base title="Dashboard — Sidebite" description="Host dashboard mock. Counts and guests are sample copy." demo>
  <div class="dash">
    <nav class="sidenav" aria-label="Dashboard">
      <a class="logo" href="/">
        <span class="logo-mark" aria-hidden="true"></span>
        <span class="logo-word">Sidebite</span>
      </a>
      <a href="/demo/dashboard" aria-current="page">Events</a>
      <a href="#guests">Guests</a>
      <a href="/#templates">Templates</a>
      <a href="/demo/account">Account</a>
    </nav>
    <main id="main" class="dash-main">
      <header class="split">
        <div>
          <h1 class="h2" data-field="name">{defaultDraft.name}</h1>
          <p><span class="pill pill-solid">Live</span> Hosting until {defaultDraft.hostingUntil}</p>
          <p class="fine"><a href="/e/demo">{eventLink(defaultDraft.slug)}</a></p>
        </div>
        <div class="row" style="flex-wrap:wrap">
          <a class="btn btn-secondary" href="/demo/editor">Edit page</a>
          <a class="btn btn-primary" href="#prompts">Message guests</a>
        </div>
      </header>
      <Provisional title="Message guests: updates and reminders from you, Milestone only" body="Dev note: needs legal sign-off before launch; include unsubscribe links and a privacy notice." />
      <section class="stats" aria-label="Snapshot">
        <article class="stat"><span class="fine">Going</span><b>42</b></article>
        <article class="stat"><span class="fine">Maybe</span><b>9</b></article>
        <article class="stat"><span class="fine">Can’t go</span><b>5</b></article>
        <article class="stat"><span class="fine">Page views</span><b>318</b></article>
      </section>
      <section class="card" style="padding:var(--space-20)">
        <h2 class="facts-title">Hosting</h2>
        <p>Live until {defaultDraft.hostingShort}</p>
        <p class="muted">Included until 1 month after your event. Keep it live after that for {keepLivePrice()}.</p>
        <a class="btn btn-secondary" href="/demo/checkout?tier=celebrate">Keep it live</a>
        <fieldset style="border:0;padding:0;margin-top:var(--space-12)">
          <legend class="strong">Takedown warnings by</legend>
          <div class="segmented" data-segment>
            <button class="btn btn-secondary" type="button" aria-pressed="false">Email</button>
            <button class="btn btn-secondary" type="button" aria-pressed="false">Text</button>
            <button class="btn btn-secondary" type="button" aria-pressed="true">Both</button>
          </div>
        </fieldset>
      </section>
      <section id="guests" aria-labelledby="rsvp-label">
        <h2 id="rsvp-label" class="facts-title">RSVPs</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>NAME</th><th>EMAIL</th><th>STATUS</th><th>NOTE</th></tr>
            </thead>
            <tbody>
              {
                guests.map((guest) => (
                  <tr>
                    <td>{guest.name}</td>
                    <td><a href={`mailto:${guest.email}`}>{guest.email}</a></td>
                    <td>{guest.status}</td>
                    <td>{guest.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p style="margin-top:var(--space-12)"><a class="btn btn-link" href="#guests">Download guest list</a></p>
      </section>
      <section id="prompts" aria-labelledby="upgrade-label">
        <h2 id="upgrade-label" class="h2">Upgrade prompts</h2>
        <p class="fine">Prompt rules · prices {money(provisional.prices.gather)} / {money(provisional.prices.celebrate)} / {money(provisional.prices.milestone)}</p>
        <div class="prompts">
          {
            upgradePrompts.map((prompt) => (
              <article class="card" style="padding:var(--space-20);display:flex;flex-direction:column;gap:var(--space-12)">
                <p class="fine">{prompt.n}</p>
                <h3 class="facts-title">{prompt.title}</h3>
                <p class="muted">{prompt.body}</p>
                {"extra" in prompt && prompt.extra && <p class="muted">{prompt.extra}</p>}
                <div class="row" style="flex-wrap:wrap">
                  <a class="btn btn-primary" href={prompt.primaryHref}>{prompt.primary}</a>
                  {"secondary" in prompt && prompt.secondary ? (
                    <a class="btn btn-secondary" href="#guests">{prompt.secondary}</a>
                  ) : (
                    <button class="btn btn-secondary" type="button" data-dismiss>Not now</button>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</Base>
<script>
  import { applyDraft } from "../../scripts/draft";
  applyDraft();
  document.querySelectorAll("[data-segment]").forEach((group) => {
    group.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest("button");
      if (!button) return;
      group.querySelectorAll("button").forEach((other) => {
        other.setAttribute("aria-pressed", String(other === button));
      });
    });
  });
  document.querySelectorAll("[data-dismiss]").forEach((button) => {
    button.addEventListener("click", () => {
      button.closest("article")?.setAttribute("hidden", "");
    });
  });
</script>
