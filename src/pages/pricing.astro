---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
import CardMarks from "../components/CardMarks.astro";
import {
  celebrateFeatures,
  freeFeatures,
  gatherFeatures,
  milestoneFeatures,
  money,
  plans,
  plansCatalog,
} from "../content/plans";
import "../styles/global.css";

const featureList = {
  free: freeFeatures,
  gather: gatherFeatures.map((label) => ({ ok: true, label })),
  celebrate: celebrateFeatures.map((label) => ({ ok: true, label })),
  milestone: milestoneFeatures.map((label) => ({ ok: true, label })),
};
---

<Base
  title="Pricing — Sidebite"
  description="Start free for a week, or pick a monthly plan. Free renews automatically as Gather. Gather, Celebrate, and Milestone include a 7-day trial."
>
  <SiteHeader current="pricing" />
  <main id="main" class="pricing">
    <header class="stack">
      <p class="kicker">PRICING</p>
      <h1 class="h2">Start free for a week, or pick a monthly plan.</h1>
      <p class="lead">
        Free is a basic page for {plansCatalog.trialDays} days, then it renews automatically as Gather at {money(plansCatalog.prices.gather)}/month. Card required. Cancel anytime before day {plansCatalog.trialDays}. Or pick a monthly plan.
      </p>
      <p class="fine" id="checkout-status" hidden>Checkout canceled. You can start a trial whenever you’re ready.</p>
    </header>

    <section class="billing" aria-label="How billing works">
      <div>
        <h2>Start free for a week</h2>
        <p class="muted">
          {money(plansCatalog.prices.free)} for {plansCatalog.trialDays} days on a basic page, then {money(plansCatalog.prices.gather)}/month as Gather. Card required. Cancel anytime before day {plansCatalog.trialDays}. Renews automatically.
        </p>
      </div>
      <div>
        <h2>Or a monthly plan</h2>
        <p class="muted">Gather, Celebrate, or Milestone. A card starts the {plansCatalog.trialDays}-day trial.</p>
      </div>
      <div>
        <h2>Pay before you build</h2>
        <p class="muted">Checkout comes first. Then you make the page.</p>
      </div>
      <div>
        <h2>Manage billing</h2>
        <p class="muted">Update your card or cancel in the billing portal.</p>
      </div>
    </section>

    <section class="tiers" aria-label="Plans">
      {
        plans.map((plan) => (
          <article class:list={["tier", plan.popular && "tier-pop"]}>
            <div class="split">
              <h2 class="facts-title">{plan.name}</h2>
              {plan.popular && <span class="pill pill-solid">Most popular</span>}
            </div>
            <p>
              <span class="price">{money(plan.price)}</span><br />
              <span class="muted">{plan.cadence}</span>
            </p>
            <p class="muted">{plan.blurb}</p>
            <hr class="rule" />
            <ul class="features">
              {featureList[plan.id].map((feature) => (
                <li>
                  <Icon name={feature.ok ? "check" : "minus"} class={feature.ok ? "ok" : "no"} />
                  <span class={feature.ok ? "" : "muted"}>{feature.label}</span>
                </li>
              ))}
            </ul>
            <div class="tier-cta">
              <CardMarks />
              {plan.id === "free" && <p class="muted">Renews automatically as Gather.</p>}
              <!--
                SIGNUP / BUILD FLOW HOOK
                Start free opens Stripe Checkout for the Gather price with a 7-day trial.
                After success, /checkout/success links to /demo/event-type as the build placeholder.
                Replace that link with the real signup and build flow when it exists.
              -->
              <a class:list={["btn", "btn-block", plan.variant === "primary" ? "btn-primary" : "btn-secondary"]} href={`/checkout/${plan.id}`}>
                {plan.cta}
              </a>
            </div>
          </article>
        ))
      }
    </section>
  </main>
  <SiteFooter />
</Base>
<script>
  if (new URLSearchParams(location.search).get("checkout") === "canceled") {
    document.getElementById("checkout-status")?.removeAttribute("hidden");
  }
</script>
