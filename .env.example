# Copy to .env for local `astro dev`. Set the same names on the Vercel project sidebitesites.
# Leave them blank to keep the site up: checkout, portal, and the webhook respond
# with "payments not configured" instead of crashing.

# Stripe secret key. Dashboard → Developers → API keys. Server only.
STRIPE_SECRET_KEY=

# Signing secret for the endpoint https://sidebitesites.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Recurring monthly Price IDs. Gather $50, Celebrate $150, Milestone $300.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# Supabase project URL and service role key. Server only. Never send the service role to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Origin for Checkout success, cancel, and billing-portal return URLs. No trailing slash.
PUBLIC_SITE_URL=https://sidebitesites.com
